{
  "name": "wra-hydrogen-fresh",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.8",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "hydrogen skills check --mode=warn && vite dev",
    "preview": "react-router build && vite preview",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc && hydrogen gql check --fail-on-warn",
    "dev:https": "hydrogen skills check --mode=warn && vite dev",
    "start": "vite preview --port ${PORT:-4173} --host 0.0.0.0",
    "start:node": "node server.mjs"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@remix-run/cookie": "^0.6.0",
    "@remix-run/session": "^0.4.3",
    "@shopify/hydrogen": "^2026.10.3",
    "isbot": "^5.1.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.3",
    "react-router-dom": "7.18.6",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "8.5.2",
    "@react-router/fs-routes": "8.5.2",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "gql.tada": "^1.9.2",
    "graphql": "^16.13.2",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20250310.0": true
  },
  "overrides": {
    "array-includes": "3.1.9"
  }
}
