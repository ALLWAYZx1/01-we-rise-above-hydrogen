# Copy to .env and fill in. Values are NOT committed.
# PUBLIC_STOREFRONT_API_TOKEN is the store's PUBLIC Storefront API token
# (Shopify admin → Hydrogen channel → Storefront API token; it is also
# exposed in the live storefront's page source by design).
SESSION_SECRET=
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_CHECKOUT_DOMAIN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOP_ID=

# Analytics tag overrides (optional). Defaults are the store's public
# GA measurement ID and Meta pixel ID; set to an empty value to disable.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
