{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{dist/server/**,app/lib/**}"
    }
  },
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "destination": "/api/index",
      "source": "/(.*)"
    }
  ]
}
