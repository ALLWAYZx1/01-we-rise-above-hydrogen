{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/handler.js": {
      "maxDuration": 30,
      "includeFiles": "dist/server/**"
    }
  },
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "destination": "/api/handler",
      "source": "/(.*)"
    }
  ]
}